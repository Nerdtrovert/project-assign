# Nhost Configuration
# IMPORTANT: Never expose Nhost admin secret to browser/client code
NHOST_BACKEND_URL=https://your-subdomain.nhost.run
NEXT_PUBLIC_NHOST_BACKEND_URL=https://your-subdomain.nhost.run
NEXT_PUBLIC_NHOST_REGION=ap-south-1
# NHOST_ADMIN_SECRET should only be used on the server-side
# NHOST_ADMIN_SECRET=your_admin_secret_here

# Optional: Next.js
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# GROQ API Key (server-side only)
# Never expose GROQ_API_KEY to the browser
GROQ_API_KEY=your_groq_api_key_here